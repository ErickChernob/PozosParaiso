# Pozos Paraiso - Apache configuration for shared hosting (Hostinger/GoDaddy public_html).
# Domain below is inferred from the site's published email addresses (@pozosparaiso.com) -
# confirm the real production domain and update the two RewriteCond lines if different.
# See MIGRATION_NOTES.md.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Force non-www (choose the www variant instead if the domain is meant to be canonical as www).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# Custom 404 page.
ErrorDocument 404 /404.html

# Prevent directory listing.
Options -Indexes

# No legacy Webflow subdomain/path redirects are defined: this project was exported
# directly from the Webflow Designer and was never live on a webflow.io subdomain
# with a different URL structure, so there is nothing to redirect from. If the site
# previously lived elsewhere with different URLs, add explicit Redirect/RewriteRule
# lines here before launch.

# ---------- Compression ----------
# Text-based assets only; images/fonts are already compressed formats and gzipping
# them again just burns CPU for no size benefit.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
  </IfModule>
</IfModule>

# ---------- Browser caching ----------
# Moderate lifetimes, not a full year: this is a hand-maintained static site with
# no cache-busting/hashed filenames, so a very long cache would make future content
# updates (e.g. swapping an image) invisible to returning visitors for a long time.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---------- Security headers ----------
# Conservative, static-site-safe set. No Content-Security-Policy here: this project
# has no build step to manage nonces/hashes for the small inline bootstrap script in
# <head>, and a misconfigured CSP is a common way to silently break a site - safer
# to leave that as a deliberate, tested addition later than guess at one now.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
